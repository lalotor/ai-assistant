# API Keys
OPENAI_API_KEY=

# Set log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable JSON output for production (default: false for development)
JSON_LOGS=false

# Path to the log file (default: logs/app.log)
LOG_FILE_PATH=logs/app.log

# Set to 'true' to enable file logging (default: false)
ENABLE_FILE_LOGGING=true

# Provider for embedding generation
EMBEDDING_PROVIDER=openai

# Path to the vector store directory
VECTOR_STORE_PATH=data/vector_store

# Vector store similarity threshold (L2 distance)
SIMILARITY_THRESHOLD=1.2

# Slow execution threshold (ms)
SLOW_EXECUTION_THRESHOLD=10000

# Question timeout (s)
QUESTION_TIMEOUT=60
