# Chat and embedding providers default to OpenAI.
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# For Gemini-only operation, set LLM_PROVIDER=gemini and
# EMBEDDING_PROVIDER=gemini, then provide GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# Set log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable JSON output for production (default: false for development)
JSON_LOGS=false

# Path to the log file (default: logs/app.log)
LOG_FILE_PATH=logs/app.log

# Set to 'true' to enable file logging (default: false)
ENABLE_FILE_LOGGING=true

# Provider for embedding generation (openai or gemini)
EMBEDDING_PROVIDER=gemini

# Path to the vector store directory
VECTOR_STORE_PATH=data/vector_store

# Vector store similarity threshold (L2 distance)
SIMILARITY_THRESHOLD=1.2

# Slow execution threshold (ms)
SLOW_EXECUTION_THRESHOLD=10000

# Question timeout (s)
QUESTION_TIMEOUT=60
