# Chat and embedding providers default to OpenAI.
OPENAI_API_KEY=
# openai, gemini, or groq
LLM_PROVIDER=groq
# Provider defaults include gpt-5.4-mini, gemini-3.5-flash-lite,
# and openai/gpt-oss-20b for Groq.
LLM_MODEL=openai/gpt-oss-20b

# For Groq chat with local embeddings, set LLM_PROVIDER=groq,
# EMBEDDING_PROVIDER=local, and provide GROQ_API_KEY.
GROQ_API_KEY=
# For Gemini chat and/or embeddings, provide GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Set log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable JSON output for production (default: false for development)
JSON_LOGS=false

# Path to the log file (default: logs/app.log)
LOG_FILE_PATH=logs/app.log

# Set to 'true' to enable file logging (default: false)
ENABLE_FILE_LOGGING=true

# Provider for embedding generation (openai, gemini, or local)
EMBEDDING_PROVIDER=local

# Path to the vector store directory
VECTOR_STORE_PATH=data/vector_store

# Vector store similarity threshold (L2 distance)
SIMILARITY_THRESHOLD=1.2

# Slow execution threshold (ms)
SLOW_EXECUTION_THRESHOLD=10000

# Question timeout (s)
QUESTION_TIMEOUT=60
